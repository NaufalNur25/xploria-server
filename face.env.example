XPLORIA_CAMERA_PORT=/dev/serial0
XPLORIA_CAMERA_BAUD=460800
XPLORIA_FACE_DIR=/var/lib/xploria/faces
XPLORIA_FACE_THRESHOLD=0.363
# Optional existing HW team database; files are read-only.
# XPLORIA_FACE_LEGACY_EMBEDDINGS_DIR=/home/xploria/face-test/embeddings
# Optional custom ONNX paths:
# XPLORIA_FACE_DETECTOR=/var/lib/xploria/faces/yunet.onnx
# XPLORIA_FACE_RECOGNIZER=/var/lib/xploria/faces/sface.onnx
